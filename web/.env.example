# Connexion à la base Supabase auto-hébergée (serveur dédié / HDS).
SUPABASE_URL=https://supabase.mon-serveur-interne.fr
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# Accès partagé à l'application (mot de passe unique pour les testeurs).
APP_PASSWORD=choisir-un-mot-de-passe
# Secret pour signer le cookie de session (chaîne aléatoire longue).
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-longue
