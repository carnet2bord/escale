# Connexion à la base Supabase auto-hébergée (serveur dédié / HDS).
SUPABASE_URL=https://supabase.mon-serveur-interne.fr
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# Accès partagé à l'application (mot de passe unique pour les testeurs).
# OBLIGATOIRE et long/à forte entropie (seule barrière vers les données).
APP_PASSWORD=choisir-un-mot-de-passe-long
# Secret pour signer le cookie de session.
# OBLIGATOIRE, >= 32 caractères aléatoires. Sans lui, l'app refuse de démarrer
# (pas de valeur par défaut : une clé connue rendrait le cookie forgeable).
# Générer : openssl rand -hex 32
SESSION_SECRET=remplacer-par-32-caracteres-aleatoires-minimum
